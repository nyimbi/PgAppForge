# ── PgAppForge environment variables ──────────────────────────────────────────
# Copy to .env and fill in values before running docker compose.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ───────────────────────────────────────────────────────────

# Flask secret key — minimum 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-32-char-key-in-production

# Primary PostgreSQL database.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://pguser:pguserpassword@postgres:5432/app

# ── PostgreSQL service ────────────────────────────────────────────────────────
POSTGRES_DB=app
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pguserpassword

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=app
# "development" | "production" | "testing"
FLASK_ENV=development
FLASK_DEBUG=1

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# Set OTEL_ENABLED=true to activate trace/metric export.
OTEL_ENABLED=false
# OTLP collector endpoint (gRPC).  Examples:
#   Jaeger all-in-one:   http://jaeger:4317
#   Grafana Tempo:       http://tempo:4317
#   Datadog agent:       http://datadog-agent:4317
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317
# "otlp" | "console" | "none"
OTEL_EXPORTER_TYPE=otlp
OTEL_SERVICE_NAME=pgappforge
OTEL_SERVICE_VERSION=4.8.0

# ── Embedding / iframe (optional) ─────────────────────────────────────────────
# Comma-separated list of allowed parent frame origins (or "*" for any).
# Leave blank to set X-Frame-Options: DENY on all responses.
# EMBED_ALLOWED_ORIGINS=https://portal.example.com,https://bank.co.ke

# ── Redis (optional — for caching and sessions) ───────────────────────────────
# REDIS_URL=redis://:redis_password@redis:6379/0
# REDIS_PASSWORD=redis_password

# ── AI / LLM features (optional) ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ENABLE_AI_ASSISTANT=true

# ── Enterprise SSO / LDAP (optional) ─────────────────────────────────────────
# ENABLE_SSO=false
# LDAP_SERVER=ldap://openldap:1389
# LDAP_BIND_DN=cn=admin,dc=example,dc=org
# LDAP_BIND_PASSWORD=admin_password

# ── Grafana / monitoring (optional) ──────────────────────────────────────────
# GRAFANA_PASSWORD=admin

# ── Security extras ───────────────────────────────────────────────────────────
# SECURITY_PASSWORD_SALT=change-this-salt
# WTF_CSRF_SECRET_KEY=change-this-too
