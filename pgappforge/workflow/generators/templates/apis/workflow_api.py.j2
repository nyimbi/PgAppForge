    @api.route('/')
    class WorkflowList(Resource):
        @api.doc('list_workflows')
        @api.marshal_with(workflow_list_model)
        @has_access
        @protect()
        def get(self):
            """List all workflows."""
            try:
                # Get query parameters
                page = request.args.get('page', 1, type=int)
                per_page = min(request.args.get('per_page', 20, type=int), 100)

                # Filter by user if not admin
                query = db.session.query({{ workflow.name }}WorkflowState)

                if not current_user.is_admin():
                    query = query.filter_by(created_by_fk=current_user.id)

                # Apply additional filters
                status = request.args.get('status')
                if status:
                    query = query.filter_by(status=status)

                current_step = request.args.get('current_step')
                if current_step:
                    query = query.filter_by(current_step=current_step)

                # Pagination
                total = query.count()
                workflows = query.offset((page - 1) * per_page).limit(per_page).all()

                return {
                    'count': total,
                    'result': [self._workflow_to_dict(w) for w in workflows]
                }

            except Exception as e:
                api.abort(500, f"Failed to list workflows: {str(e)}")

        @api.doc('create_workflow')
        @api.expect(workflow_model)
        @api.marshal_with(workflow_model, code=201)
        @has_access
        @protect()
        def post(self):
            """Create a new workflow."""
            try:
                data = request.get_json()

                # Validate initial data
                initial_step = '{{ workflow.steps.keys() | list | first }}'
                form_class = {{ workflow.steps.keys() | list | first }}Form
                form = form_class(data=data)

                if not form.validate():
                    api.abort(400, "Validation failed", errors=form.errors)

                # Create workflow state
                engine = get_workflow_engine()
                workflow_state = engine.create_workflow_state(
                    workflow_name='{{ workflow.name }}',
                    entity_type='{{ workflow.name }}WorkflowState',
                    entity_id=None,
                    initial_data=data
                )

                # Set form data
                for field_name, value in data.items():
                    if hasattr(workflow_state, field_name):
                        setattr(workflow_state, field_name, value)

                db.session.commit()

                return self._workflow_to_dict(workflow_state), 201

            except IntegrityError as e:
                db.session.rollback()
                api.abort(400, f"Data integrity error: {str(e)}")
            except Exception as e:
                db.session.rollback()
                api.abort(500, f"Failed to create workflow: {str(e)}")

    @api.route('/<string:workflow_id>')
    class WorkflowDetail(Resource):
        @api.doc('get_workflow')
