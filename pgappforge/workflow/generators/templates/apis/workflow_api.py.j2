    @api.route('/<string:workflow_id>/advance')
    class WorkflowAdvance(Resource):
        @api.doc('advance_workflow')
        @api.marshal_with(workflow_model)
        @has_access
        @protect()
        def post(self, workflow_id):
            """Advance workflow to next step."""
            try:
                workflow = self._get_workflow_or_404(workflow_id)

                # Check permissions
                user_roles = [role.name for role in current_user.roles]
                next_step = workflow.get_next_step_for_user(user_roles)

                if not next_step:
                    api.abort(400, "No available next step for user")

                # Advance workflow
                engine = get_workflow_engine()
                success = engine.advance_workflow(workflow, next_step)

                if not success:
                    api.abort(400, "Failed to advance workflow")

                db.session.commit()

                return self._workflow_to_dict(workflow)

            except Exception as e:
                db.session.rollback()
                api.abort(500, f"Failed to advance workflow: {str(e)}")

    def _get_workflow_or_404(self, workflow_id):
        """Get workflow or raise 404."""
        workflow = db.session.query({{ workflow.name }}WorkflowState).filter_by(id=workflow_id).first()
        if not workflow:
            api.abort(404, "Workflow not found")
        return workflow

    def _can_edit_workflow(self, workflow):
        """Check if current user can edit workflow."""
        if current_user.is_admin():
            return True

        user_roles = [role.name for role in current_user.roles]
        return workflow.can_user_edit_step(workflow.current_step, user_roles)

    def _workflow_to_dict(self, workflow):
        """Convert workflow to dictionary."""
        return {
            'id': workflow.id,
            'workflow_name': workflow.workflow_name,
            'current_step': workflow.current_step,
            'status': workflow.status,
            'progress_percentage': workflow.step_progress_percentage,
            'created_at': workflow.created_at.isoformat() if workflow.created_at else None,
            'last_activity_at': workflow.last_activity_at.isoformat() if workflow.last_activity_at else None,
            {% for field in fields %}
            '{{ field.name }}': getattr(workflow, '{{ field.name }}', None),
            {% endfor %}
        }


