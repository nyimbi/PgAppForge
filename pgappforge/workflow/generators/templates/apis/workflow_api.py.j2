        def get(self, workflow_id):
            """Get workflow by ID."""
            try:
                workflow = db.session.query({{ workflow.name }}WorkflowState).filter_by(id=workflow_id).first()
                if not workflow:
                    api.abort(404, "Workflow not found")

                # Check permissions
                if not current_user.is_admin() and workflow.created_by_fk != current_user.id:
                    api.abort(403, "Access denied")

                return self._workflow_to_dict(workflow)

            except Exception as e:
                api.abort(500, f"Failed to get workflow: {str(e)}")

