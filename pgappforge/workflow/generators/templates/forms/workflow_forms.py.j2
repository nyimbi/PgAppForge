# Form validation helper functions
def validate_workflow_step_data(step_name: str, form_data: dict, workflow_state=None) -> dict:
    """Validate workflow step data and return errors."""
    errors = {}

    {% for step_name, step_config in workflow.steps.items() %}
    if step_name == '{{ step_name }}':
        form = {{ step_name }}Form(data=form_data)
        if not form.validate():
            errors.update(form.errors)

        {% if step_config.validation and step_config.validation.business %}
        # Additional business validation
        {% for rule in step_config.validation.business %}
        try:
            if not globals().get('validate_{{ rule }}', lambda **kwargs: True)(
                form_data=form_data,
                workflow_state=workflow_state
            ):
                errors.setdefault('general', []).append('{{ rule }} validation failed')
        except Exception as e:
            errors.setdefault('general', []).append(f'{{ rule }} validation error: {e}')
        {% endfor %}
        {% endif %}
    {% endfor %}

    return errors


