{
  "name": "darwin-core",
  "label": "Darwin Core (Biodiversity)",
  "description": "Biodiversity occurrence data \u2014 GBIF global database, natural history collections worldwide",
  "color": "#27ae60",
  "icon": "fa-frog",
  "version": "2024-02-28",
  "source_url": "https://dwc.tdwg.org/",
  "tags": [
    "biodiversity",
    "ecology",
    "gbif",
    "natural-history",
    "science"
  ],
  "tables": {
    "dwc_dataset": [
      {
        "name": "id",
        "type": "UUID",
        "pk": true
      },
      {
        "name": "name",
        "type": "VARCHAR(500)",
        "nullable": false
      },
      {
        "name": "publisher",
        "type": "VARCHAR(500)"
      },
      {
        "name": "description",
        "type": "TEXT"
      },
      {
        "name": "license",
        "type": "VARCHAR(100)"
      },
      {
        "name": "pub_date",
        "type": "DATE"
      },
      {
        "name": "language",
        "type": "CHAR(5)"
      }
    ],
    "dwc_occurrence": [
      {
        "name": "id",
        "type": "UUID",
        "pk": true
      },
      {
        "name": "occurrence_id",
        "type": "VARCHAR(255)",
        "unique": true
      },
      {
        "name": "dataset_id",
        "type": "UUID",
        "fk": "dwc_dataset.id"
      },
      {
        "name": "catalog_number",
        "type": "VARCHAR(100)"
      },
      {
        "name": "collection_code",
        "type": "VARCHAR(100)"
      },
      {
        "name": "institution_code",
        "type": "VARCHAR(50)"
      },
      {
        "name": "basis_of_record",
        "type": "VARCHAR(50)"
      },
      {
        "name": "occurrence_status",
        "type": "VARCHAR(20)"
      },
      {
        "name": "event_date",
        "type": "DATE"
      },
      {
        "name": "decimal_latitude",
        "type": "DOUBLE PRECISION"
      },
      {
        "name": "decimal_longitude",
        "type": "DOUBLE PRECISION"
      },
      {
        "name": "coordinate_uncertainty_m",
        "type": "NUMERIC(10,2)"
      },
      {
        "name": "country_code",
        "type": "CHAR(2)"
      },
      {
        "name": "locality",
        "type": "TEXT"
      },
      {
        "name": "individual_count",
        "type": "INTEGER"
      },
      {
        "name": "organism_quantity",
        "type": "NUMERIC(12,4)"
      },
      {
        "name": "organism_quantity_type",
        "type": "VARCHAR(50)"
      },
      {
        "name": "recorded_by",
        "type": "TEXT"
      },
      {
        "name": "identified_by",
        "type": "TEXT"
      },
      {
        "name": "habitat",
        "type": "TEXT"
      },
      {
        "name": "established_means",
        "type": "VARCHAR(50)"
      },
      {
        "name": "occurrence_remarks",
        "type": "TEXT"
      }
    ],
    "dwc_taxon": [
      {
        "name": "id",
        "type": "SERIAL",
        "pk": true
      },
      {
        "name": "taxon_id",
        "type": "VARCHAR(255)",
        "unique": true
      },
      {
        "name": "scientific_name",
        "type": "VARCHAR(500)",
        "nullable": false
      },
      {
        "name": "kingdom",
        "type": "VARCHAR(100)"
      },
      {
        "name": "phylum",
        "type": "VARCHAR(100)"
      },
      {
        "name": "class",
        "type": "VARCHAR(100)"
      },
      {
        "name": "order_name",
        "type": "VARCHAR(100)"
      },
      {
        "name": "family",
        "type": "VARCHAR(100)"
      },
      {
        "name": "genus",
        "type": "VARCHAR(100)"
      },
      {
        "name": "specific_epithet",
        "type": "VARCHAR(100)"
      },
      {
        "name": "taxon_rank",
        "type": "VARCHAR(30)"
      },
      {
        "name": "vernacular_names",
        "type": "JSONB"
      },
      {
        "name": "taxonomic_status",
        "type": "VARCHAR(30)"
      },
      {
        "name": "iucn_status",
        "type": "VARCHAR(20)"
      }
    ],
    "dwc_occurrence_taxon": [
      {
        "name": "id",
        "type": "SERIAL",
        "pk": true
      },
      {
        "name": "occurrence_id",
        "type": "UUID",
        "fk": "dwc_occurrence.id"
      },
      {
        "name": "taxon_id",
        "type": "INTEGER",
        "fk": "dwc_taxon.id"
      },
      {
        "name": "identification_qualifier",
        "type": "VARCHAR(100)"
      }
    ]
  }
}