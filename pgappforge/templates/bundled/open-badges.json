      },
      {
        "name": "tags",
        "type": "JSONB"
      },
      {
        "name": "created_at",
        "type": "TIMESTAMPTZ",
        "default": "NOW()"
      }
    ],
    "ob_assertion": [
      {
        "name": "id",
        "type": "UUID",
        "pk": true
