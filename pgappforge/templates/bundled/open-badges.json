      },
      {
        "name": "url",
        "type": "TEXT"
      },
      {
        "name": "email",
        "type": "VARCHAR(320)"
      },
      {
        "name": "description",
        "type": "TEXT"
      },
      {
        "name": "image_url",
        "type": "TEXT"
      },
      {
        "name": "public_key",
        "type": "TEXT"
      }
    ],
    "ob_badge_class": [
      {
        "name": "id",
        "type": "UUID",
        "pk": true
      },
      {
        "name": "issuer_id",
        "type": "UUID",
        "fk": "ob_issuer.id"
      },
      {
        "name": "name",
        "type": "VARCHAR(255)",
        "nullable": false
      },
      {
        "name": "description",
