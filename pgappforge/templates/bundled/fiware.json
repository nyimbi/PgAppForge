{
  "name": "fiware",
  "label": "FIWARE Smart Data Models",
  "description": "EU-backed open data models \u2014 smart cities, agrifood, energy, environment",
  "color": "#3498db",
  "icon": "fa-smart-city",
  "version": "2024",
  "source_url": "https://smartdatamodels.org/",
  "tags": [
    "smart-city",
    "eu",
    "iot",
    "fiware",
    "environment"
  ],
  "tables": {
    "fw_weather_observed": [
      {
        "name": "id",
        "type": "UUID",
        "pk": true
      },
      {
        "name": "station_id",
        "type": "VARCHAR(100)"
      },
      {
        "name": "name",
        "type": "VARCHAR(255)"
      },
      {
        "name": "location",
        "type": "GEOGRAPHY(POINT,4326)"
      },
      {
        "name": "observed_at",
        "type": "TIMESTAMPTZ",
        "nullable": false
      },
      {
        "name": "temperature",
        "type": "NUMERIC(6,2)"
      },
      {
        "name": "feels_like_temperature",
        "type": "NUMERIC(6,2)"
