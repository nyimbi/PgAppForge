version: '3.8'

services:
  # {{ workflow.name }} Workflow Application
  {{ workflow.name.lower() }}-app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ workflow.name.lower() }}-workflow-app
    environment:
      - FLASK_ENV=production
      - FLASK_APP=app.py
      - SQLALCHEMY_DATABASE_URI=postgresql://{{ workflow.name.lower() }}_user:{{ workflow.name.lower() }}_pass@postgres:5432/{{ workflow.name.lower() }}_workflow
      - REDIS_URL=redis://redis:6379/0
      - SECRET_KEY=${SECRET_KEY:-default-secret-key-change-in-production}
      - CELERY_BROKER_URL=redis://redis:6379/1
      - CELERY_RESULT_BACKEND=redis://redis:6379/2
      - FAB_UPDATE_PERMS=True
      - FAB_SECURITY_MANAGER_CLASS=flask_appbuilder.security.sqla.manager.SecurityManager

    ports:
      - "8080:8080"
    depends_on:
      - postgres
      - redis
    volumes:
      - ./logs:/app/logs
      - ./uploads:/app/uploads
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network

  # PostgreSQL Database
  postgres:
    image: postgres:14-alpine
    container_name: {{ workflow.name.lower() }}-postgres
    environment:
      - POSTGRES_DB={{ workflow.name.lower() }}_workflow
      - POSTGRES_USER={{ workflow.name.lower() }}_user
      - POSTGRES_PASSWORD={{ workflow.name.lower() }}_pass
      - POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./sql/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    ports:
      - "5432:5432"
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ workflow.name.lower() }}_user -d {{ workflow.name.lower() }}_workflow"]
      interval: 30s
      timeout: 10s
      retries: 5

  # Redis for Caching and Celery
  redis:
    image: redis:7-alpine
    container_name: {{ workflow.name.lower() }}-redis
    command: redis-server --appendonly yes --requirepass {{ workflow.name.lower() }}_redis_pass
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5

  # Celery Worker for Background Tasks
  celery-worker:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ workflow.name.lower() }}-celery-worker
    command: celery -A app.celery worker --loglevel=info --concurrency=4
    environment:
      - FLASK_ENV=production
      - SQLALCHEMY_DATABASE_URI=postgresql://{{ workflow.name.lower() }}_user:{{ workflow.name.lower() }}_pass@postgres:5432/{{ workflow.name.lower() }}_workflow
      - REDIS_URL=redis://redis:6379/0
      - CELERY_BROKER_URL=redis://redis:6379/1
      - CELERY_RESULT_BACKEND=redis://redis:6379/2
      - SECRET_KEY=${SECRET_KEY:-default-secret-key-change-in-production}
    depends_on:
      - postgres
      - redis
    volumes:
      - ./logs:/app/logs
      - ./uploads:/app/uploads
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network

  # Celery Beat for Scheduled Tasks
  celery-beat:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ workflow.name.lower() }}-celery-beat
    command: celery -A app.celery beat --loglevel=info --schedule=/tmp/celerybeat-schedule
    environment:
      - FLASK_ENV=production
      - SQLALCHEMY_DATABASE_URI=postgresql://{{ workflow.name.lower() }}_user:{{ workflow.name.lower() }}_pass@postgres:5432/{{ workflow.name.lower() }}_workflow
      - REDIS_URL=redis://redis:6379/0
      - CELERY_BROKER_URL=redis://redis:6379/1
      - CELERY_RESULT_BACKEND=redis://redis:6379/2
      - SECRET_KEY=${SECRET_KEY:-default-secret-key-change-in-production}
    depends_on:
      - postgres
      - redis
    volumes:
      - ./logs:/app/logs
      - celery_beat_data:/tmp
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network

  # Nginx Reverse Proxy
  nginx:
    image: nginx:alpine
    container_name: {{ workflow.name.lower() }}-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
      - ./static:/var/www/static:ro
    depends_on:
      - {{ workflow.name.lower() }}-app
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network

  # Monitoring with Prometheus (Optional)
  prometheus:
    image: prom/prometheus:latest
    container_name: {{ workflow.name.lower() }}-prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=200h'
      - '--web.enable-lifecycle'
    ports:
      - "9090:9090"
    volumes:
      - ./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network
    profiles:
      - monitoring

  # Grafana for Metrics Visualization (Optional)
  grafana:
    image: grafana/grafana:latest
    container_name: {{ workflow.name.lower() }}-grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin123
      - GF_USERS_ALLOW_SIGN_UP=false
    ports:
      - "3000:3000"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./monitoring/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./monitoring/grafana/datasources:/etc/grafana/provisioning/datasources:ro
    depends_on:
      - prometheus
    restart: unless-stopped
    networks:
      - {{ workflow.name.lower() }}-network
    profiles:
      - monitoring

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
  celery_beat_data:
    driver: local
  prometheus_data:
    driver: local
  grafana_data:
    driver: local

networks:
  {{ workflow.name.lower() }}-network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.{{ (workflow.name | hash | abs % 200) + 20 }}.0.0/16

# Environment Variables Documentation:
#
# Required:
# - SECRET_KEY: Flask secret key (minimum 20 characters)
#
# Optional:
# - FLASK_ENV: Flask environment (development/production)
# - LOG_LEVEL: Application log level (DEBUG/INFO/WARNING/ERROR)
# - MAIL_SERVER: SMTP server for email notifications
# - MAIL_PORT: SMTP port (default: 587)
# - MAIL_USERNAME: SMTP username
# - MAIL_PASSWORD: SMTP password
# - OAUTH_PROVIDERS: JSON string of OAuth providers configuration
#
# Database Options:
# - SQLALCHEMY_DATABASE_URI: Override default PostgreSQL connection
# - DATABASE_POOL_SIZE: Connection pool size (default: 10)
# - DATABASE_POOL_TIMEOUT: Pool timeout in seconds (default: 20)
#
# Redis Options:
# - REDIS_URL: Override default Redis connection
# - REDIS_PASSWORD: Redis authentication password
#
# Security:
# - CSRF_ENABLED: Enable CSRF protection (default: True)
# - SESSION_COOKIE_SECURE: Use secure cookies (default: True in production)
# - PERMANENT_SESSION_LIFETIME: Session timeout in seconds
#
# Workflow-Specific:
# - WORKFLOW_AUTO_SAVE_INTERVAL: Auto-save interval in seconds (default: 30)
# - WORKFLOW_NOTIFICATION_ENABLED: Enable notifications (default: True)
# - WORKFLOW_COLLABORATION_ENABLED: Enable real-time collaboration (default: True)